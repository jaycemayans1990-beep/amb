-- แก้ไข Slider ไม่ให้เชื่อม Event ซ้ำซ้อน
local activeSliderUpdate = nil

local function createSlider(text, min, max, default, step, callback)
    layoutOrder = layoutOrder + 1
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 48)
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    frame.BorderSizePixel = 0
    frame.LayoutOrder = layoutOrder
    frame.Parent = ScrollFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 0, 20)
    label.Position = UDim2.new(0.04, 0, 0, 3)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 11
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.3, 0, 0, 20)
    valLabel.Position = UDim2.new(0.65, 0, 0, 3)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(default)
    valLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    valLabel.TextSize = 11
    valLabel.Font = Enum.Font.SourceSansBold
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.Parent = frame

    local sliderBar = Instance.new("TextButton")
    sliderBar.Size = UDim2.new(0.92, 0, 0, 6)
    sliderBar.Position = UDim2.new(0.04, 0, 0, 30)
    sliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    sliderBar.Text = ""
    sliderBar.AutoButtonColor = false
    sliderBar.Parent = frame

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(0, 3)
    barCorner.Parent = sliderBar

    local sliderFill = Instance.new("Frame")
    local initialRatio = math.clamp((default - min) / (max - min), 0, 1)
    sliderFill.Size = UDim2.new(initialRatio, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBar

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 3)
    fillCorner.Parent = sliderFill

    local function updateSlider(input)
        local barAbsPos = sliderBar.AbsolutePosition.X
        local barAbsSize = sliderBar.AbsoluteSize.X
        local mousePos = input.Position.X
        local ratio = math.clamp((mousePos - barAbsPos) / barAbsSize, 0, 1)
        local rawValue = min + (ratio * (max - min))
        local steppedValue = math.floor(rawValue / step + 0.5) * step
        steppedValue = math.clamp(steppedValue, min, max)

        sliderFill.Size = UDim2.new((steppedValue - min) / (max - min), 0, 1, 0)
        valLabel.Text = tostring(steppedValue)
        callback(steppedValue)
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSliderUpdate = updateSlider
            MainFrame.Draggable = false
            updateSlider(input)
        end
    end)
end

-- Global Input Handler สำหรับ Slider (แก้ไข Event Leak)
UserInputService.InputChanged:Connect(function(input)
    if activeSliderUpdate and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        activeSliderUpdate(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        activeSliderUpdate = nil
        MainFrame.Draggable = true
    end
end)

